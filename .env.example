# ==============================================================================
# PT CAKRAWALA MAGNA SCIENTIA (CakraNexa) - ENVIRONMENT CONFIGURATION
# Arsitektur: Vite/React SPA (Vercel) + Express API (Render) + Supabase (PostgreSQL)
# Salin file ini menjadi `.env` (lokal). Di Vercel/Render, isi lewat dashboard Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (di-bundle ke browser oleh Vite — HANYA nilai yang aman dipublikasikan, prefix VITE_)
# ------------------------------------------------------------------------------

# URL backend Express. Kosongkan jika frontend & API dilayani dari server yang sama (mode dev / Render full-stack).
# Produksi decoupled (Vercel): https://cakranexa-api.onrender.com
VITE_API_BASE_URL=""

# Supabase (opsional di frontend; hanya untuk fallback baca katalog jika API mati)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Midtrans CLIENT key (aman dipublikasikan). Prefix SB- = sandbox, Mid-client- = production.
VITE_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 2. BACKEND (Express / Render) — RAHASIA, tidak pernah dikirim ke browser
# ------------------------------------------------------------------------------
NODE_ENV="development"
# Render/Cloud Run menyuntikkan PORT otomatis; lokal default 3000
PORT=3000

# URL publik situs (dipakai sitemap/robots jika belum diatur dari Admin > SEO)
SITE_URL="https://cakranexa.com"

# Origin frontend yang diizinkan CORS (pisahkan dengan koma). *.vercel.app & localhost diizinkan otomatis.
ALLOWED_ORIGINS="https://cakranexa.com,https://www.cakranexa.com,https://cakranexa.vercel.app"

# Supabase (server): URL + SERVICE ROLE KEY (bypass RLS — wajib rahasia)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# Autentikasi Portal Admin (/admin). WAJIB diisi dengan password kuat sebelum deploy.
ADMIN_PASSWORD=""
# Opsional: API key statis untuk integrasi server-to-server (header X-Admin-Key). Boleh dikosongkan.
ADMIN_API_KEY=""

# Midtrans SERVER key (membuat Snap token & verifikasi signature webhook)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# RajaOngkir / Logistics API Key (opsional; belum terintegrasi — tarif saat ini estimasi internal)
RAJAONGKIR_API_KEY=""
